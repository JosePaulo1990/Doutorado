function capitaliseFirstLetter(string)
{
    return string.charAt(0).toUpperCase() + string.slice(1).toLowerCase();
}

/* Formats an element of the result-list */
function format(result){
	if(!result.id) { 
		return '<div class="result_label" style="background-color: #E8E8E8 "><img src="/scripts/images/select2/' + result.type + '.png" />' + result.title + '</div>';
		
	}
	else return '<div  class="result_entry" id="' + result.id + '">' + result.title + '</div>';
}
/* Formats a tag in select2 */
function formatSelection(item) {
        return '<div class="' + item.type + '">' + '<img src="/scripts/images/select2/' + item.type + '.png" />' + item.title + "</div>";
}

function formatNoMatches(term){
	return 'Hittade inga fler träffar';
}

function formatInputTooShort(term, minLength){
	if(minLength == 1) return 'Mata in ett tecken';
	else return 'Mata in ' + (minLength - term.length) + ' till tecken';
}

