/* Initializes the select2-element. We use three lists of items to match input words. The lists of items
*  are: $cities, $providers and $subjects. These lists are collected with ajax before select2 is initialized.
*  We filter each of these lists with the input word, and then checks if filtered element already is added to
*  select2. If there exists items of a list which not is added, we add the items and a label. Free items are
*  a bit tricky. Select2 cannot automatically check that they already exists in the list so we use a help-function
*  to accomplish this.
*/
function initSelect2(){
   var word;
   var select2 = $("#tags").select2({
        placeholder: "Skriv in skola, ämne, stad eller fritext",
        minimumInputLength: 3,
        multiple: true,
        //minimumInputLength: 1,
        query: function (query) {
            word = query.term.charAt(0) + query.term.slice(1);
            var cities = [{ title: 'Stad', type: 'city'}].concat(checkAlreadyAdded(filter(word,$cities,'title') )); 
            var providers = [{ title: 'Lärosäten', type: 'provider'}].concat(checkAlreadyAdded(filter(word,$providers,'title'))); 
            var subjects = [{ title: 'Ämnen', type: 'subject'}].concat(checkAlreadyAdded(filter(word,$subjects,'title')));
            var result = [];
            if(cities.length > 1) result = result.concat(cities);
            if(providers.length > 1) result = result.concat(providers);
            if(subjects.length > 1) result = result.concat(subjects);
            var freeElem = { id: $id++, title : word.charAt(0).toUpperCase() + word.slice(1), type : 'free'};
            if(!checkFreeAlreadyExists(freeElem)){
            	    var freeText = [{ title: 'Fritext', type: 'free'}, freeElem];
            	    result = result.concat(freeText);
            	    console.log("Sets $free to: " + word);
            	    $free = word;
            } else{ $free = undefined; }
            
            var data = {results: result};
            query.callback(data);
        },
        formatResult: format,
        formatSelection: formatSelection, 
        formatNoMatches: formatNoMatches,
        formatInputTooShort: formatInputTooShort,
        }).data('select2');
   //If one tag is removed we do not care about any previously written text
   $("#tags").on('change',function(e){ if(e.removed || e.added) $free = undefined});
//   console.log("FOOBAR");
}
/* Checks if the specified free word (elem) already exists in the list of
   added words. If so returns true, otherwise false.
*/
function checkFreeAlreadyExists(elem){
	var exists = false;
	$($('#tags').select2('data')).each(function(){
			if(this.type == 'free' && this.title == elem.title){
				exists = true;
				return;
			}
	});
	return exists;
}

/* Takes a list of items to be inserted to select2. If one item already
 * exists in the list, we remove it from the list and return a list of 
 * elements not present in the select2. Because of this we do not have to
 * include labels for types which not can be added (because select2 automagically
 * deletes duplicates by checking id (this does not work for free words, because we
 * generate new ids for them, we solve this by using checkFreeAlreadyExists(elem)
*/
function checkAlreadyAdded(list){
	var checkedList = [];
	$(list).each(function(){
		var item = this;
		var exists = false;
		$($('#tags').select2('data')).each(function(){
			if(item.id == this.id){
				exists = true;
				return;
			}
		});
		if(!exists) checkedList.push(this);
	});
	return checkedList;
}
/* Matches a list of elements with a word and returns only elements which contains
 * the specified word.
*/
function filter(word, list, identifier) {
    var regex = new RegExp(word.toLowerCase());
    return $.grep(list, function(s) {
        if(identifier == 'title') return s.title.toLowerCase().match(regex);
        if(identifier == 'extra') return s.extra.toLowerCase().match(regex);
    });
}

