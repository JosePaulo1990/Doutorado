		et_disable_toptier = jQuery("meta[name=et_disable_toptier]").attr('content');

	if ( et_bg_image_speed === '' ) et_bg_image_speed = 8000;
	if ( et_service_image_speed === '' ) et_service_image_speed = 1000;

	if ( $et_background_image.length > 1 ) {
