      params = JSON.stringify(params);

      $.ajax({
        type: 'post',
        url: listing_ajax.ajaxurl,
        data: {
          action: 'generate_new_view',
          layout: layout,
          params: params,
          page: $('.page_of').data('page'),
          page_id: listing_ajax.post_id
