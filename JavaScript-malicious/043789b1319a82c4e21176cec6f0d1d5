u0432\u0438\u0442 \u0437\u0430\u043a\u0430\u0437 \u043f\u0440\u044f\u043c\u043e \u043a \u0434\u0432\u0435\u0440\u0438 \u0434\u043e\u043c\u0430.\u0421\u0430\u043c\u043e\u0432\u044b\u0432\u043e\u0437\u043e\u043c \u0438\u0437 \u0428\u043e\u0443\u0440\u0443\u043c\u0430. \u0415\u0441\u043b\u0438 \u0436\u0435\u043b\u0430\u0435\u0442\u0435 \u0437\u0430\u0431\u0440\u0430\u0442\u044c \u0441\u0432\u043e\u0439 \u0437\u0430\u043a\u0430\u0437 \u043b\u0438\u0447\u043d\u043e, \u0442\u043e \u0441\u0430\u043c\u043e\u0432\u044b\u0432\u043e\u0437 - \u044d\u0442\u043e \u043b\u0443\u0447\u0448\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442. \u0428\u043e\u0443\u0440\u0443\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0438\u043d\u0442\u0438\u043c\u043d\u044b\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0410\u043c\u0443\u0440\u0447\u0438\u043a \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041a\u0438\u0435\u0432, \u0423\u043a\u0440\u0430\u0438\u043d\u0430. \u0423\u0442\u043e\u0447\u043d\u044f\u0439\u0442\u0435 \u0433\u0440\u0430\u0444\u0438\u043a \u0440\u0430\u0431\u043e\u0442\u044b \u0442\u043e\u0447\u043a\u0438 \u0432\u044b\u0434\u0430\u0447\u0438 \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443, \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u043c\u0443 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u0441\u0435\u043a\u0441 \u0448\u043e\u043f \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0410\u043c\u0443\u0440\u0447\u0438\u043a.\u0422\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u0432 \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0438 \u0441\u0435\u043a\u0441 \u0438\u0433\u0440\u0443\u0448\u0435\u043a (\u0441\u044d\u043a\u0441\u0448\u043e\u043f)\u041d\u0430\u0448 \u043e\u043d\u043b\u0430\u0439\u043d \u0441\u044d\u043a\u0441\u0448\u043e\u043f \u043c\u0430\u0433\u0430\u0437\u0438\u043d - \u21161 \u0441\u0440\u0435\u0434\u0438 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u0432, \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u044e\u0449\u0438\u0445\u0441\u044f \u043d\u0430 \u0438\u043d\u0442\u0438\u043c\u043d\u044b\u0445 \u0442\u043e\u0432\u0430\u0440\u0430\u0445 \u0423\u043a\u0440\u0430\u0438\u043d\u044b. \u041c\u0430\u0433\u0430\u0437\u0438\u043d \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d \u0432 \u0433\u043e\u0440\u043e\u0434\u0435 \u041a\u0438\u0435\u0432, \u043d\u043e \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442 \u0430\u043d\u043e\u043d\u0438\u043c\u043d\u0443\u044e \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0443 \u043f\u043e \u0432\u0441\u0435\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438 \u0423\u043a\u0440\u0430\u0438\u043d\u044b. Sex Shop \u0410\u043c\u0443\u0440\u0447\u0438\u043a \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0430\u0441\u0441\u043e\u0440\u0442\u0438\u043c\u0435\u043d\u0442 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u0435\u043a\u0441-\u0438\u0433\u0440\u0443\u0448\u0435\u043a \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430, \u043f\u043e \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439 \u0446\u0435\u043d\u0435. \u0412\u0441\u0435 \u0438\u043d\u0442\u0438\u043c\u043d\u044b\u0435 \u0438\u0433\u0440\u0443\u0448\u043a\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u044b \u043f\u043e \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0442 \u0432\u0441\u0435\u043c \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f\u043c \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. \u0421\u0435\u043a\u0441-\u0438\u0433\u0440\u0443\u0448\u043a\u0438 \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u044b \u0441 \u0443\u0447\u0435\u0442\u043e\u043c \u0430\u043d\u0430\u0442\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0435\u0439 \u043c\u0443\u0436\u0447\u0438\u043d \u0438 \u0436\u0435\u043d\u0449\u0438\u043d, \u0430 \u0442\u0430\u043a\u0436\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u043c\u0443\u0436\u0441\u043a\u043e\u0433\u043e, \u0436\u0435\u043d\u0441\u043a\u043e\u0433\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043c\u0430. \u0418\u043d\u0442\u0438\u043c\u043d\u044b\u0435 \u0442\u043e\u0432\u0430\u0440\u044b \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b \u043f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 (\u043f\u0440\u0438 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u043c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u043f\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044e) \u0438 \u0431\u0435\u0437\u0432\u0440\u0435\u0434\u043d\u044b \u0434\u043b\u044f \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f. \u0418\u0433\u0440\u0443\u0448\u043a\u0438 \u043d\u0435 \u0438\u043c\u0435\u044e\u0442 \u043e\u0441\u0442\u0440\u044b\u0445 \u0443\u0433\u043b\u043e\u0432, \u043d\u0435\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0445 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432 \u0438\u043b\u0438 \u0441\u0432\u0435\u0440\u0445\u044a\u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0444\u043e\u0440\u043c, \u043f\u0440\u0438\u043d\u043e\u0441\u044f\u0449\u0438\u0445 \u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442 \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0437\u043d\u0435\u043d\u043d\u044b\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f. \u0412\u0441\u0435 \u0434\u0435\u0432\u0430\u0439\u0441\u044b \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u0434\u043b\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0432\u0430\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0440 \u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u0444\u043e\u0440\u043c\u044b. \u0421\u0435\u043a\u0441-\u0438\u0433\u0440\u0443\u0448\u043a\u0438 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043d\u044b\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f, \u0432\u0435\u0434\u044c \u043e\u043d\u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u044b \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u043d\u0430\u0441\u043b\u0430\u0436\u0434\u0435\u043d\u0438\u0435 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0441\u0435\u043a\u0441\u0430 \u0441 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u043e\u043c \u0438\u043b\u0438 \u0441\u043e\u043b\u043e \u0441\u0442\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.\u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b\u0421\u0435\u043a\u0441-\u0438\u0433\u0440\u0443\u0448\u043a\u0438 - \u044d\u0442\u043e \u043b\u0443\u0447\u0448\u0435\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0442\u0435\u0445, \u043a\u0442\u043e \u0441\u0442\u0440\u0435\u043c\u0438\u0442\u0441\u044f \u043a \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u0438\u044e \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0436\u0438\u0437\u043d\u0438, \u043d\u043e\u0432\u044b\u043c \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f\u043c \u0438 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044e. \u0422\u0430\u043a\u0438\u0435 \u0434\u0435\u0432\u0430\u0439\u0441\u044b \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u044b \u0434\u043b\u044f \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f, \u0430 \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u043e\u043d\u0438 \u0438\u0437 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0432\u0440\u0435\u0434\u044f\u0442 \u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044e, \u043d\u0435 \u0432\u044b\u0437\u044b\u0432\u0430\u044e\u0442 \u0434\u0438\u0441\u043a\u043e\u043c\u0444\u043e\u0440\u0442. \u041c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u044b \u043d\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442 \u0432 \u0441\u043e\u0441\u0442\u0430\u0432\u0430\u0445 \u0444\u0442\u0430\u043b\u0430\u0442\u043e\u0432 \u0438 \u0432\u0440\u0435\u0434\u043d\u044b\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432. \u041e\u043d\u0438 \u043f\u0440\u043e\u0447\u043d\u044b\u0435, \u0431\u0435\u0437\u0432\u0440\u0435\u0434\u043d\u044b\u0435, \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0438\u043d\u0442\u0438\u043c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0441 \u043a\u043e\u043c\u0444\u043e\u0440\u0442\u043e\u043c. \u0418\u0433\u0440\u044b \u0441 \u0438\u043d\u0442\u0438\u043c-\u0434\u0435\u0432\u0430\u0439\u0441\u0430\u043c\u0438 \u0431\u0443\u0434\u0443\u0442 \u043f\u0440\u0438\u043d\u043e\u0441\u0438\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0435 \u0442\u0430\u043a\u0442\u0438\u043b\u044c\u043d\u044b\u0435 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u044f \u0438 \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u0435. \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c\u0438 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430\u043c\u0438, \u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044e\u0442 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u0441\u0435\u043a\u0441-\u0438\u0433\u0440\u0443\u0448\u043a\u0438, \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044e\u0442:\u0441\u0438\u043b\u0438\u043a\u043e\u043d. \u0411\u0430\u0440\u0445\u0430\u0442\u0438\u0441\u0442\u044b\u0439, \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439, \u043d\u0435\u0436\u043d\u044b\u0439;\u043a\u0438\u0431\u0435\u0440\u043a\u043e\u0436\u0430. \u041f\u0440\u0435\u043c\u0438\u0443\u043c \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b. \u041d\u0430 \u043e\u0449\u0443\u043f\u044c \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0443\u044e \u043a\u043e\u0436\u0443. \u041c\u044f\u0433\u043a\u0438\u0439, \u0433\u043b\u0430\u0434\u043a\u0438\u0439, \u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439;\u0442\u0435\u0440\u043c\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u044d\u043b\u0430\u0441\u0442\u043e\u043c\u0435\u0440 (TPE). \u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 TPE \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044e\u0442 \u043a\u0438\u0431\u0435\u0440\u043a\u043e\u0436\u0443. \u041f\u0440\u0438\u044f\u0442\u043d\u044b\u0439 \u043d\u0430 \u043e\u0449\u0443\u043f\u044c;\u0442\u0435\u0440\u043c\u043e\u043f\u043b\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0440\u0435\u0437\u0438\u043d\u0430 (TPR). \u041f\u0440\u043e\u0447\u043d\u044b\u0439, \u0433\u0438\u0431\u043a\u0438\u0439, \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0439 \u043a \u0442\u0440\u0435\u043d\u0438\u044e;\u043f\u043b\u0430\u0441\u0442\u0438\u043a (ABS). \u0422\u0432\u0435\u0440\u0434\u044b\u0439, \u043f\u0440\u043e\u0447\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b. \u041e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0433\u0438\u0431\u043a\u043e\u0441\u0442\u044c, \u044d\u043b\u0430\u0441\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c. \u0418\u0437 \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430, \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u043c, \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0431\u044e\u0434\u0436\u0435\u0442\u043d\u044b\u0435 \u0438\u0437\u0434\u0435\u043b\u0438\u044f;\u043f\u043e\u043b\u0438\u0432\u0438\u043d\u0438\u043b\u0445\u043b\u043e\u0440\u0438\u0434 (PVC). \u041d\u0435\u0434\u043e\u0440\u043e\u0433\u043e\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b. \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043a\u0430\u043a \u044d\u043b\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u043c, \u0433\u0438\u0431\u043a\u0438\u043c, \u0442\u0430\u043a \u0442\u0432\u0435\u0440\u0434\u044b\u043c, \u043f\u0440\u043e\u0447\u043d\u044b\u043c;\u0441\u0442\u0435\u043a\u043b\u043e. \u041f\u0440\u043e\u0447\u043d\u044b\u0439, \u0442\u0435\u0440\u043c\u043e\u0441\u0442\u043e\u0439\u043a\u0438\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b. \u041f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043b\u044e\u0431\u044b\u0435 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u044b. \u0413\u0438\u043f\u043e\u0430\u043b\u043b\u0435\u0440\u0433\u0435\u043d\u043d\u044b\u0439, \u0431\u0435\u0437\u0432\u0440\u0435\u0434\u043d\u044b\u0439.\u041b\u0443\u0447\u0448\u0438\u0435 \u043d\u043e\u0432\u0438\u043d\u043a\u0438 \u0441\u0435\u043a\u0441 \u0448\u043e\u043f\u0430Amurchik - \u044d\u0442\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0441\u0435\u043a\u0441\u0448\u043e\u043f (sex shop) \u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0432 \u041a\u0438\u0435\u0432\u0435 (\u0441 \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u043e\u0439 \u043f\u043e \u0432\u0441\u0435\u0439 \u0423\u043a\u0440\u0430\u0438\u043d\u0435), \u0430\u0441\u0441\u043e\u0440\u0442\u0438\u043c\u0435\u043d\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u043f\u043e\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u043d\u043e\u0432\u0438\u043d\u043a\u0430\u043c\u0438 \u0438 \u043c\u0438\u0440\u043e\u0432\u044b\u043c\u0438 \u0431\u0435\u0441\u0442\u0441\u0435\u043b\u043b\u0435\u0440\u0430\u043c\u0438 \u0432 \u043c\u0438\u0440\u0435 \u0438\u043d\u0442\u0438\u043c \u0442\u043e\u0432\u0430\u0440\u043e\u0432. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u0445, \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043d\u043e\u0432\u0438\u043d\u043e\u043a, \u0441\u0435\u043a\u0441-\u0438\u0433\u0440\u0443\u0448\u0435\u043a \u0438 \u0438\u043d\u0442\u0438\u043c\u043d\u044b\u0445 \u0438\u0437\u0434\u0435\u043b\u0438\u0439 \u0443\u0436\u0435 \u0435\u0441\u0442\u044c \u043d\u0430 \u043d\u0430\u0448\u0435\u043c \u0441\u0430\u0439\u0442\u0435, \u0432\u0435\u0434\u044c \u043c\u044b \u043e\u043f\u0435\u0440\u0430\u0442\u0438\u0432\u043d\u043e \u043f\u043e\u043f\u043e\u043b\u043d\u044f\u0435\u043c \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u0441\u0435\u043a\u0441-\u0438\u0433\u0440\u0443\u0448\u0435\u043a \u043d\u043e\u0432\u044b\u043c\u0438 \u0442\u0440\u0435\u043d\u0434\u043e\u0432\u044b\u043c\u0438 \u0434\u0435\u0432\u0430\u0439\u0441\u0430\u043c\u0438 \u0434\u043b\u044f \u0441\u0435\u043a\u0441\u0430. \u041a\u0430\u0442\u0430\u043b\u043e\u0433 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0441\u0435\u043a\u0441 \u0448\u043e\u043f\u0430 \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f, \u0430 \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c, \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u044c, \u0437\u0430\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0432 \u0441\u0435\u043a\u0441\u0448\u043e\u043f\u0435 \u043d\u043e\u0432\u044b\u0435 \u0438\u0433\u0440\u0443\u0448\u043a\u0438 \u043f\u043e \u0440\u0430\u0437\u043d\u043e\u0439 \u0446\u0435\u043d\u043e\u0432\u043e\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438. \u0416\u0435\u043b\u0430\u0435\u0442\u0435 \u0431\u044b\u0442\u044c \u043f\u0435\u0440\u0432\u044b\u043c \u0441\u0447\u0430\u0441\u0442\u043b\u0438\u0432\u044b\u043c \u043e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u0435\u043c \u043d\u043e\u0432\u0438\u043d\u043a\u0438 \u0432 \u0423\u043a\u0440\u0430\u0438\u043d\u0435 (\u0423\u043a\u0440\u0430\u0438\u043d\u0430)? \u0422\u043e\u0433\u0434\u0430 Ba\u043c \u0432 \u0441\u0435\u043a\u0448\u043e\u043f (ctrc ijg) \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0447\u0438\u043a \u0410\u043c\u0443\u0440\u0447\u0438\u043a.\u0413\u043e\u0440\u044f\u0447\u0430\u044f \u043b\u0438\u043d\u0438\u044f\u0413\u043e\u0440\u044f\u0447\u0430\u044f \u043b\u0438\u043d\u0438\u044f \u0441\u0435\u043a\u0441 \u0448\u043e\u043f \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0410\u043c\u0443\u0440\u0447\u0438\u043a\u0430 - \u044d\u0442\u043e \u0441\u0430\u043c\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u0443\u0437\u043d\u0430\u0442\u044c \u0432\u0441\u044e \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0443\u044e\u0449\u0443\u044e \u0412\u0430\u0441 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043f\u043e \u043f\u043e\u0432\u043e\u0434\u0443 \u043b\u044e\u0431\u043e\u0433\u043e \u0438\u043d\u0442\u0438\u043c \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0435\u0441\u0442\u044c \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u0438\u043b\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u043d\u0430\u0439\u0442\u0438. \u041f\u043e \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u043c\u0443 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 sexshop \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 (+38044-359-05-93) B\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044e \u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u0443\u044e \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u043e \u043f\u043e\u0438\u0441\u043a\u0443 \u0438\u043b\u0438 \u043f\u043e\u0434\u0431\u043e\u0440\u0443 \u0442\u043e\u0432\u0430\u0440\u0430. \u041d\u0430\u0448\u0438 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u044b \u043f\u043e\u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u0442\u044c \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u0434\u0435\u0432\u0430\u0439\u0441 \u0434\u043b\u044f \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0443\u0434\u043e\u0432\u043e\u043b\u044c\u0441\u0442\u0432\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u043e \u043f\u043e\u0434\u043e\u0439\u0434\u0435\u0442 \u0412\u0430\u043c \u0438\u043b\u0438 \u0412\u0430\u0448\u0435\u043c\u0443 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0443. \u0417\u0432\u043e\u043d\u0438\u0442\u044c \u043c\u043e\u0436\u0435\u0442\u0435 \u0441 9.00 \u0434\u043e 20.00. \u0422\u0430\u043a\u0436\u0435 \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0441\u0432\u043e\u0439 \u043d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0432 \u0440\u0443\u0431\u0440\u0438\u043a\u0435 \u041f